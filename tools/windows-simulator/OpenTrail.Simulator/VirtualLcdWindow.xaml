<Window x:Class="OpenTrail.Simulator.VirtualLcdWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenTrail Simulator"
        Width="600" Height="760" MinWidth="570" MinHeight="690"
        WindowStartupLocation="Manual"
        Background="{DynamicResource WindowBrush}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        AutomationProperties.AutomationId="virtual-lcd-window"
        Closing="HandleWindowClosing">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Margin="0,0,0,8" Padding="10,7"
                BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1"
                Background="{DynamicResource PanelBrush}">
            <DockPanel LastChildFill="True">
                <TextBlock x:Name="SourceBannerText" DockPanel.Dock="Left" Text="UNASSIGNED" FontWeight="Bold"
                           Foreground="{DynamicResource WarningBrush}"
                           AutomationProperties.HeadingLevel="Level2" />
                <TextBlock x:Name="SourceEvidenceText"
                           Text="Select one public device choice before connecting"
                           Margin="12,0,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource MutedBrush}" />
            </DockPanel>
        </Border>

        <!-- Device/session controls are host chrome and intentionally outside the LCD. -->
        <Border Grid.Row="1" Margin="0,0,0,8" Padding="10"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Row="0">
                    <TextBlock x:Name="ClientNameText" FontSize="20" FontWeight="Bold"
                               AutomationProperties.HeadingLevel="Level1" />
                    <TextBlock x:Name="DeviceLabelText" Foreground="{DynamicResource MutedBrush}" />
                    <TextBlock x:Name="ConnectionStateText" FontWeight="Bold"
                               AutomationProperties.AutomationId="connection-state"
                               AutomationProperties.LiveSetting="Assertive" />
                    <TextBlock x:Name="FreshnessText" FontSize="11"
                               Foreground="{DynamicResource MutedBrush}" />
                </StackPanel>
                <UniformGrid Grid.Row="0" Grid.Column="1" Rows="1" Columns="3" VerticalAlignment="Center">
                    <Button x:Name="ConnectButton" Content="_Connect" Click="ConnectClient" />
                    <Button x:Name="DisconnectButton" Content="_Disconnect" Click="DisconnectClient" />
                    <Button x:Name="ReconnectButton" Content="_Reconnect" Click="ReconnectClient" />
                </UniformGrid>
                <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Device choice" FontWeight="Bold" />
                        <ComboBox x:Name="DeviceChoiceCombo"
                                  DisplayMemberPath="DisplayText"
                                  MinWidth="280" MinHeight="44"
                                  SelectionChanged="HandleDeviceChoiceSelectionChanged"
                                  AutomationProperties.Name="Public device choice" />
                        <Border x:Name="AssignedDeviceChoiceBorder"
                                MinWidth="280" MinHeight="44" Margin="4"
                                Padding="8" Visibility="Collapsed"
                                Background="{DynamicResource PanelBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1">
                            <TextBlock x:Name="AssignedDeviceChoiceText"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"
                                       AutomationProperties.Name="Assigned public device choice" />
                        </Border>
                        <TextBlock x:Name="DeviceChoiceStatusText"
                                   FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource MutedBrush}" />
                    </StackPanel>
                    <UniformGrid Grid.Column="1" Rows="1" Columns="3"
                                 VerticalAlignment="Bottom">
                        <Button x:Name="RefreshChoicesButton" Content="_Refresh"
                                Click="RefreshDeviceChoices" />
                        <Button x:Name="UseChoiceButton" Content="_Use"
                                Click="SelectDeviceChoice" />
                        <Button x:Name="ForgetChoiceButton" Content="_Forget"
                                Click="ForgetDeviceChoice" />
                    </UniformGrid>
                </Grid>
            </Grid>
        </Border>

        <Viewbox Grid.Row="2" Stretch="Uniform" StretchDirection="Both">
            <Grid Width="486" Height="486"
                  AutomationProperties.Name="Native OpenTrail portable UI render plan">
                <Ellipse Fill="{DynamicResource LcdBrush}"
                         Stroke="{DynamicResource BorderBrush}" StrokeThickness="3" />
                <Canvas x:Name="LcdCanvas" Width="466" Height="466"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        AutomationProperties.AutomationId="firmware-lcd-surface" />
            </Grid>
        </Viewbox>

        <StackPanel Grid.Row="3" Margin="4,8,4,0">
            <TextBlock x:Name="HostNoticeText" Text="Starting native portable UI session…"
                       TextWrapping="Wrap" TextAlignment="Center"
                       Foreground="{DynamicResource MutedBrush}"
                       AutomationProperties.AutomationId="host-notice"
                       AutomationProperties.LiveSetting="Polite" />
            <TextBlock x:Name="HostErrorText" Text="" Visibility="Collapsed"
                       TextWrapping="Wrap" TextAlignment="Center"
                       Foreground="{DynamicResource CriticalBrush}"
                       AutomationProperties.AutomationId="host-error"
                       AutomationProperties.LiveSetting="Assertive" />
            <TextBlock x:Name="PublicBridgeErrorText" Text="" Visibility="Collapsed"
                       TextWrapping="Wrap" TextAlignment="Center"
                       Foreground="{DynamicResource CriticalBrush}"
                       AutomationProperties.AutomationId="public-bridge-error"
                       AutomationProperties.LiveSetting="Assertive" />
        </StackPanel>
    </Grid>
</Window>
