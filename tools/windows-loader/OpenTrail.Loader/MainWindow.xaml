<Window x:Class="OpenTrail.Loader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenTrail Firmware Loader"
        Width="1120" Height="760" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#12171D" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1" Padding="30,22">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="OPENTRAIL / LOCAL SERVICE" Foreground="{StaticResource AccentBrush}"
                               FontFamily="Segoe UI Semibold" FontSize="12" />
                    <TextBlock Text="Firmware Loader" FontFamily="Segoe UI Semibold"
                               FontSize="30" Margin="0,4,0,0" />
                    <TextBlock x:Name="PhaseText" Text="Inspection only"
                               Foreground="{StaticResource MutedTextBrush}" FontSize="14" Margin="0,3,0,0" />
                </StackPanel>
                <Button x:Name="RefreshButton" Grid.Column="1" Content="Refresh devices"
                        Click="RefreshButton_Click" VerticalAlignment="Center"
                        Background="{StaticResource AccentBrush}" Foreground="White"
                        BorderBrush="{StaticResource AccentBrush}" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="30,26,30,30">
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="SummaryText" Text="Looking for connected devices…"
                                   FontFamily="Segoe UI Semibold" FontSize="24" />
                        <TextBlock Text="USB inspection is read-only. Device identity and pairing data stay hidden."
                                   Foreground="{StaticResource MutedTextBrush}" FontSize="14" Margin="0,6,0,0" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="#18314B" CornerRadius="16" Padding="12,7"
                            VerticalAlignment="Top">
                        <TextBlock Text="NO WRITER CONNECTED" Foreground="#9CC7FF"
                                   FontFamily="Segoe UI Semibold" FontSize="11" />
                    </Border>
                </Grid>

                <Border Background="#202833" BorderBrush="#3A4654" BorderThickness="1"
                        CornerRadius="8" Padding="16" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="30" Height="30" CornerRadius="15" Background="#284E75">
                            <TextBlock Text="i" FontFamily="Segoe UI Semibold" FontSize="17"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock x:Name="NoticeText" Grid.Column="1" TextWrapping="Wrap"
                                   Margin="12,2,0,0" Foreground="#D7E5F5" FontSize="14" />
                    </Grid>
                </Border>

                <Border x:Name="ErrorBanner" Visibility="Collapsed" Background="#3A2020"
                        BorderBrush="#8C4242" BorderThickness="1" CornerRadius="8"
                        Padding="14" Margin="0,0,0,18">
                    <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="#FFD5D5" />
                </Border>

                <ItemsControl x:Name="DeviceCards">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="330" MinHeight="340" Margin="0,0,16,16" Padding="20"
                                    Background="{StaticResource PanelBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Candidate}" Foreground="{StaticResource MutedTextBrush}"
                                                   FontFamily="Consolas" FontSize="11" />
                                        <Border Grid.Column="1" Background="#24364A" CornerRadius="12" Padding="9,4">
                                            <TextBlock Text="USB" Foreground="#9CC7FF" FontSize="11" />
                                        </Border>
                                    </Grid>
                                    <TextBlock Grid.Row="1" Text="{Binding DisplayName}"
                                               FontFamily="Segoe UI Semibold" FontSize="22" Margin="0,16,0,0" />
                                    <StackPanel Grid.Row="2" Margin="0,5,0,16">
                                        <TextBlock Text="{Binding InstalledRuntime}" Foreground="{StaticResource MutedTextBrush}" />
                                        <TextBlock Text="{Binding FirmwareDisplay}" FontFamily="Consolas" FontSize="12"
                                                   Foreground="#C6CDD6" Margin="0,5,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="3">
                                        <TextBlock Text="WHY FLASH IS BLOCKED" Foreground="{StaticResource AccentBrush}"
                                                   FontFamily="Segoe UI Semibold" FontSize="11" Margin="0,0,0,7" />
                                        <ItemsControl ItemsSource="{Binding Blockers}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding StringFormat=• {0}}" TextWrapping="Wrap"
                                                               Foreground="#C8D0DA" FontSize="12" Margin="0,0,0,5" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                    <Grid Grid.Row="4" Margin="0,18,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Connected and inspected" Foreground="#7FD1A5"
                                                   FontFamily="Segoe UI Semibold" FontSize="12"
                                                   VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Content="Flash" IsEnabled="False"
                                                Background="#242A31" Foreground="#7F8994"
                                                BorderBrush="#3A424C" Padding="14,7" Cursor="Arrow" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#12171D" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="30,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="SAFE MODE" Foreground="{StaticResource AccentBrush}"
                               FontFamily="Segoe UI Semibold" FontSize="11" />
                    <TextBlock Text="Inspect and explain only — no firmware file or device mutation path exists."
                               Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Select firmware" IsEnabled="False" Margin="0,0,8,0"
                            Background="#242A31" Foreground="#7F8994" BorderBrush="#3A424C" Cursor="Arrow" />
                    <Button Content="Flash selected device" IsEnabled="False"
                            Background="#242A31" Foreground="#7F8994" BorderBrush="#3A424C" Cursor="Arrow" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
