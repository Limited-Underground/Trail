<Window x:Class="OpenTrail.Loader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle, Mode=OneTime, FallbackValue=Device Utility}"
        Width="1120" Height="760" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        AutomationProperties.Name="{Binding WindowTitle, Mode=OneTime, FallbackValue=Device Utility}"
        AutomationProperties.AutomationId="device-utility-window"
        KeyboardNavigation.TabNavigation="Cycle"
        SnapsToDevicePixels="True" UseLayoutRounding="True"
        SizeChanged="MainWindow_SizeChanged"
        Background="{DynamicResource BackgroundBrush}">
    <Window.CommandBindings>
        <CommandBinding Command="NavigationCommands.Refresh"
                        CanExecute="RefreshCommand_CanExecute"
                        Executed="RefreshCommand_Executed" />
    </Window.CommandBindings>
    <Window.InputBindings>
        <KeyBinding Key="F5" Command="NavigationCommands.Refresh" />
    </Window.InputBindings>
    <Grid Background="{DynamicResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource ButtonBorderBrush}"
                BorderThickness="0,0,0,2" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding HeaderLine, Mode=OneTime}" Foreground="{DynamicResource AccentTextBrush}"
                               FontFamily="Microsoft Sans Serif" FontWeight="Bold" FontSize="11" />
                    <TextBlock Text="{Binding UtilityRoleName, Mode=OneTime}" Foreground="{DynamicResource AccentTextBrush}"
                               FontFamily="Microsoft Sans Serif" FontWeight="Bold"
                               FontSize="24" Margin="0,4,0,0" />
                    <TextBlock x:Name="PhaseText" Text="Inspection only"
                               Foreground="{DynamicResource AccentTextBrush}" FontSize="13" Margin="0,3,0,0" />
                </StackPanel>
                <Button x:Name="RefreshButton" Grid.Column="1" Content="Refresh devices"
                        Click="RefreshButton_Click" VerticalAlignment="Center"
                        AutomationProperties.AutomationId="refresh-devices"
                        AutomationProperties.Name="Refresh connected devices"
                        AutomationProperties.HelpText="Read connected USB candidates again without changing a device. Keyboard shortcut F5."
                        Background="{DynamicResource ButtonFaceBrush}" Foreground="{DynamicResource ButtonTextBrush}"
                        BorderBrush="{DynamicResource ButtonBorderBrush}" />
            </Grid>
        </Border>

        <ScrollViewer x:Name="ContentScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="16,16,16,20">
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="SummaryText" Text="Looking for connected devices…"
                                   AutomationProperties.AutomationId="inspection-summary"
                                   AutomationProperties.Name="{Binding RelativeSource={RelativeSource Self}, Path=Text}"
                                   AutomationProperties.HelpText="Current connected-device inspection summary."
                                   AutomationProperties.LiveSetting="Polite"
                                   FontFamily="Microsoft Sans Serif" FontWeight="Bold" FontSize="20" />
                        <TextBlock Text="Connected-device inspection is read-only. Device identity and pairing data stay hidden."
                                   Foreground="{DynamicResource MutedTextBrush}" FontSize="14" Margin="0,6,0,0" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="2" CornerRadius="0" Padding="10,5"
                            VerticalAlignment="Top">
                        <TextBlock Text="NO WRITER CONNECTED" Foreground="{DynamicResource InfoTextBrush}"
                                   FontFamily="Microsoft Sans Serif" FontWeight="Bold" FontSize="11" />
                    </Border>
                </Grid>

                <Border x:Name="ContentWidthAnchor"
                        Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="2"
                        CornerRadius="0" Padding="12" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="24" Height="24" CornerRadius="0" Background="{DynamicResource InfoSurfaceBrush}">
                            <TextBlock Text="i" Foreground="{DynamicResource InfoSurfaceTextBrush}" FontFamily="Microsoft Sans Serif"
                                       FontWeight="Bold" FontSize="15"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock x:Name="NoticeText" Grid.Column="1" TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="safety-notice"
                                   AutomationProperties.Name="{Binding RelativeSource={RelativeSource Self}, Path=Text}"
                                   AutomationProperties.HelpText="Current inspection safety notice."
                                   Margin="10,2,0,0" Foreground="{DynamicResource TextBrush}" FontSize="13" />
                    </Grid>
                </Border>

                <Border x:Name="ErrorBanner" Visibility="Collapsed" Background="{DynamicResource CriticalSurfaceBrush}"
                        BorderBrush="{DynamicResource CriticalTextBrush}" BorderThickness="2" CornerRadius="0"
                        Padding="14" Margin="0,0,0,18">
                    <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="{DynamicResource CriticalTextBrush}"
                               AutomationProperties.AutomationId="inspection-error"
                               AutomationProperties.Name="{Binding RelativeSource={RelativeSource Self}, Path=Text}"
                               AutomationProperties.HelpText="Current connected-device inspection error."
                               AutomationProperties.LiveSetting="Assertive" />
                </Border>

                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="2"
                        Padding="10" Margin="0,0,0,16">
                    <TextBlock x:Name="SelectionText"
                               Text="Select one connected device to continue. Selection is not Flash permission."
                               AutomationProperties.AutomationId="device-selection-status"
                               AutomationProperties.Name="{Binding RelativeSource={RelativeSource Self}, Path=Text}"
                               AutomationProperties.HelpText="Current connected-device selection status."
                               AutomationProperties.LiveSetting="Polite"
                               Foreground="{DynamicResource InfoTextBrush}" FontWeight="Bold" FontSize="12"
                               TextWrapping="Wrap" />
                </Border>

                <ListBox x:Name="DeviceCards" SelectionMode="Single"
                         SelectionChanged="DeviceCards_SelectionChanged"
                         PreviewKeyDown="DeviceCards_PreviewKeyDown"
                         Background="Transparent" BorderThickness="0" Padding="0"
                         Width="{Binding ElementName=ContentWidthAnchor, Path=ActualWidth}"
                         HorizontalAlignment="Left"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         KeyboardNavigation.TabNavigation="Once"
                         AutomationProperties.AutomationId="connected-device-candidates"
                         AutomationProperties.Name="Connected device candidates"
                         AutomationProperties.HelpText="Choose exactly one current connected candidate. Refresh clears the selection.">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="FocusVisualStyle" Value="{DynamicResource AccessibleFocusVisual}" />
                            <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleSummary}" />
                            <Setter Property="AutomationProperties.HelpText" Value="{Binding FlashHelpText}" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="CardBorder" Width="330" MinHeight="570"
                                    Margin="0,0,12,12" Padding="16"
                                    Background="{DynamicResource PanelBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="2"
                                    CornerRadius="0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Candidate}" Foreground="{DynamicResource MutedTextBrush}"
                                                   AutomationProperties.Name="Connected candidate reference"
                                                   FontFamily="Courier New" FontSize="11" />
                                        <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1" CornerRadius="0" Padding="8,3">
                                            <TextBlock Text="{Binding Connection}" Foreground="{DynamicResource InfoTextBrush}" FontSize="11" />
                                        </Border>
                                    </Grid>
                                    <TextBlock Grid.Row="1" Text="{Binding DisplayName}"
                                               FontFamily="Microsoft Sans Serif" FontWeight="Bold"
                                               FontSize="19" Margin="0,14,0,0" />
                                    <StackPanel Grid.Row="2" Margin="0,5,0,16">
                                        <TextBlock Text="{Binding InstalledRuntime}" Foreground="{DynamicResource MutedTextBrush}" />
                                        <TextBlock Text="{Binding FirmwareDisplay}" FontFamily="Courier New" FontSize="12"
                                                   Foreground="{DynamicResource TextBrush}" Margin="0,5,0,0" />
                                        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="2"
                                                Padding="9" Margin="0,12,0,0">
                                            <StackPanel>
                                                <TextBlock Text="HARDWARE PROFILE CANDIDATE" Foreground="{DynamicResource InfoTextBrush}"
                                                           FontWeight="Bold" FontSize="10" />
                                                <TextBlock Text="{Binding HardwareProfile.ProfileCandidate}"
                                                           FontWeight="Bold" TextWrapping="Wrap" Margin="0,5,0,0" />
                                                <TextBlock Text="{Binding HardwareProfile.EvidenceLevel}"
                                                           Foreground="{DynamicResource CriticalTextBrush}" FontWeight="Bold" FontSize="11"
                                                           Margin="0,3,0,0" />
                                                <TextBlock Text="{Binding HardwareProfile.ObservedNow}"
                                                           TextWrapping="Wrap" FontSize="11" Margin="0,6,0,0" />
                                                <TextBlock Text="{Binding HardwareProfile.PublishedBaseline}"
                                                           TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" FontSize="11"
                                                           Margin="0,5,0,0" />
                                                <TextBlock Text="{Binding HardwareProfile.RestartDisplay}"
                                                           Foreground="{DynamicResource InfoTextBrush}" FontWeight="Bold" FontSize="10"
                                                           Margin="0,7,0,0" />
                                                <TextBlock Text="{Binding HardwareProfile.NextStep}"
                                                           TextWrapping="Wrap" FontSize="11" Margin="0,3,0,0" />
                                                <Border Background="{DynamicResource WarningSurfaceBrush}" BorderBrush="{DynamicResource WarningBorderBrush}"
                                                        BorderThickness="1" Padding="6" Margin="0,7,0,0">
                                                    <TextBlock Text="{Binding HardwareProfile.MaintenanceCaution}"
                                                               TextWrapping="Wrap" Foreground="{DynamicResource CriticalTextBrush}"
                                                               FontWeight="Bold" FontSize="10" />
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Grid.Row="3">
                                        <TextBlock Text="WHY FLASH IS BLOCKED" Foreground="{DynamicResource InfoTextBrush}"
                                                   FontFamily="Microsoft Sans Serif" FontWeight="Bold"
                                                   FontSize="11" Margin="0,0,0,7" />
                                        <ItemsControl ItemsSource="{Binding Blockers}"
                                                      Focusable="False"
                                                      KeyboardNavigation.IsTabStop="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding StringFormat=• {0}}" TextWrapping="Wrap"
                                                               Foreground="{DynamicResource TextBrush}" FontSize="12" Margin="0,0,0,5" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                    <Grid Grid.Row="4" Margin="0,18,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding InspectionStatus}" Foreground="{DynamicResource SuccessTextBrush}"
                                                   FontFamily="Microsoft Sans Serif" FontWeight="Bold" FontSize="12"
                                                   VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Content="Flash" IsEnabled="False"
                                                AutomationProperties.HelpText="{Binding FlashHelpText}"
                                                Background="{DynamicResource ButtonFaceBrush}" Foreground="{DynamicResource DisabledTextBrush}"
                                                BorderBrush="{DynamicResource ButtonBorderBrush}" Padding="14,7" Cursor="Arrow" />
                                    </Grid>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}"
                                             Value="True">
                                    <Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource SelectedSurfaceBrush}" />
                                    <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource SelectedBorderBrush}" />
                                    <Setter TargetName="CardBorder" Property="BorderThickness" Value="3" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,2,0,0" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="26" Height="26" Background="{DynamicResource InfoSurfaceBrush}" BorderBrush="{DynamicResource ButtonBorderBrush}"
                        BorderThickness="1" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock Text="B" Foreground="{DynamicResource InfoSurfaceTextBrush}" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="BundleSummaryText" Text="No firmware bundle selected"
                               AutomationProperties.AutomationId="bundle-summary"
                               AutomationProperties.Name="{Binding RelativeSource={RelativeSource Self}, Path=Text}"
                               AutomationProperties.HelpText="Current firmware bundle inspection status."
                               AutomationProperties.LiveSetting="Polite"
                               FontFamily="Microsoft Sans Serif" FontWeight="Bold"
                               Foreground="{DynamicResource InfoTextBrush}" FontSize="12" />
                    <TextBlock x:Name="BundleDetailsText"
                               Text="Selection performs bounded structural and SHA-256 inspection only."
                               Foreground="{DynamicResource TextBrush}" FontSize="11" Margin="0,2,0,0" />
                    <TextBlock x:Name="BundleBlockerText"
                               Text="BLOCKED: Signature trust, an authoritative device profile, and release admission are required."
                               Foreground="{DynamicResource CriticalTextBrush}" FontWeight="Bold" FontSize="10" Margin="0,2,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="3" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,2,0,0" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="SAFE MODE" Foreground="{DynamicResource InfoTextBrush}"
                               FontFamily="Microsoft Sans Serif" FontWeight="Bold" FontSize="11" />
                    <TextBlock Text="Inspect and explain only — no firmware write or device mutation path exists."
                               Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,3,0,0" />
                    <TextBlock Text="{Binding ReviewStatus, Mode=OneTime}"
                               Foreground="{DynamicResource MutedTextBrush}" FontSize="10" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="SelectFirmwareButton" Content="Select firmware bundle"
                            IsEnabled="False"
                            Click="SelectFirmwareButton_Click" Margin="0,0,8,0"
                            AutomationProperties.AutomationId="select-firmware-bundle"
                            AutomationProperties.HelpText="Select a local candidate bundle for bounded structural and SHA-256 inspection. This does not authorize or write firmware."
                            Background="{DynamicResource ButtonFaceBrush}" Foreground="{DynamicResource ButtonTextBrush}" BorderBrush="{DynamicResource ButtonBorderBrush}" Cursor="Arrow" />
                    <Button x:Name="FlashSelectedButton" Content="Flash selected device" IsEnabled="False"
                            AutomationProperties.AutomationId="flash-selected-device"
                            AutomationProperties.HelpText="Unavailable because no firmware writer is connected."
                            Background="{DynamicResource ButtonFaceBrush}" Foreground="{DynamicResource DisabledTextBrush}" BorderBrush="{DynamicResource ButtonBorderBrush}" Cursor="Arrow" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
