<Application x:Class="OpenTrail.Loader.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="BackgroundBrush" Color="#C0C0C0" />
        <SolidColorBrush x:Key="PanelBrush" Color="#C0C0C0" />
        <SolidColorBrush x:Key="PanelRaisedBrush" Color="#DFDFDF" />
        <SolidColorBrush x:Key="BorderBrush" Color="#808080" />
        <SolidColorBrush x:Key="TextBrush" Color="#000000" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#404040" />
        <SolidColorBrush x:Key="AccentBrush" Color="#000080" />
        <SolidColorBrush x:Key="InfoTextBrush" Color="#000080" />
        <SolidColorBrush x:Key="InfoSurfaceBrush" Color="#000080" />
        <SolidColorBrush x:Key="InfoSurfaceTextBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="CriticalTextBrush" Color="#800000" />
        <SolidColorBrush x:Key="CriticalSurfaceBrush" Color="#FFD8D8" />
        <SolidColorBrush x:Key="WarningSurfaceBrush" Color="#FFFFE1" />
        <SolidColorBrush x:Key="WarningBorderBrush" Color="#808000" />
        <SolidColorBrush x:Key="SuccessTextBrush" Color="#006000" />
        <SolidColorBrush x:Key="SelectedSurfaceBrush" Color="#DDEBFF" />
        <SolidColorBrush x:Key="SelectedBorderBrush" Color="#000080" />
        <SolidColorBrush x:Key="DisabledTextBrush" Color="#404040" />
        <SolidColorBrush x:Key="FocusBrush" Color="#000000" />
        <SolidColorBrush x:Key="ButtonFaceBrush" Color="#C0C0C0" />
        <SolidColorBrush x:Key="ButtonTextBrush" Color="#000000" />
        <SolidColorBrush x:Key="ButtonBorderBrush" Color="#000000" />
        <SolidColorBrush x:Key="ButtonHighlightBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ButtonShadowBrush" Color="#000000" />
        <SolidColorBrush x:Key="ButtonHoverBrush" Color="#D4D4D4" />
        <SolidColorBrush x:Key="ButtonPressedBrush" Color="#B0B0B0" />

        <Style x:Key="AccessibleFocusVisual">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Margin="2" Stroke="{DynamicResource FocusBrush}"
                                   StrokeThickness="1" StrokeDashArray="1,1"
                                   SnapsToDevicePixels="True" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Microsoft Sans Serif" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="Microsoft Sans Serif" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Background" Value="{DynamicResource ButtonFaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ButtonTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource AccessibleFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonHighlight" BorderBrush="{DynamicResource ButtonHighlightBrush}"
                                BorderThickness="2,2,0,0" SnapsToDevicePixels="True">
                            <Border x:Name="ButtonShadow" BorderBrush="{DynamicResource ButtonShadowBrush}"
                                    BorderThickness="0,0,2,2">
                                <Border x:Name="ButtonBorder"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        SnapsToDevicePixels="True">
                                    <ContentPresenter Margin="{TemplateBinding Padding}"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                      RecognizesAccessKey="True"
                                                      TextElement.Foreground="{TemplateBinding Foreground}" />
                                </Border>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ButtonHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonHighlight" Property="BorderBrush" Value="{DynamicResource ButtonShadowBrush}" />
                                <Setter TargetName="ButtonShadow" Property="BorderBrush" Value="{DynamicResource ButtonHighlightBrush}" />
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ButtonPressedBrush}" />
                                <Setter TargetName="ButtonBorder" Property="Padding" Value="1,1,0,0" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ButtonFaceBrush}" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
