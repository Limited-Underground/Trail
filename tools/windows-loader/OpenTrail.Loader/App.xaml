<Application x:Class="OpenTrail.Loader.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="BackgroundBrush" Color="#0E1116" />
        <SolidColorBrush x:Key="PanelBrush" Color="#171C23" />
        <SolidColorBrush x:Key="PanelRaisedBrush" Color="#1D242D" />
        <SolidColorBrush x:Key="BorderBrush" Color="#303946" />
        <SolidColorBrush x:Key="TextBrush" Color="#F4F7FA" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#A7B0BC" />
        <SolidColorBrush x:Key="AccentBrush" Color="#FF6B2C" />
        <SolidColorBrush x:Key="InfoBrush" Color="#68A8FF" />
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI Semibold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Application.Resources>
</Application>
