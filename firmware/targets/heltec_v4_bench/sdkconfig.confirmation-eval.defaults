# OT216 opt-in evaluation only; shares the existing enabled BLE controller.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=24576
# OT224 observed ot_ble_host overflow with the SDK 4096-byte default.
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=8192
CONFIG_BT_CTRL_MODEM_SLEEP=n
CONFIG_PM_ENABLE=n
CONFIG_LIBSODIUM_USE_MBEDTLS_SHA=n
CONFIG_APP_REPRODUCIBLE_BUILD=y
CONFIG_APP_COMPILE_TIME_DATE=n
